# Server Port (assigned automatically by cloud platforms like Render/Railway/Heroku)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection String
# Get your free URI at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostelpro?retryWrites=true&w=majority

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=generate_a_long_random_secret_string_here_min_32_chars

# Frontend Client URL(s) - Comma-separated if multiple (e.g. production domain, local dev)
# Example: https://my-hostel.vercel.app,https://my-hostel.netlify.app
CLIENT_URL=http://localhost:5173

# Optional: Default Initial Admin Credentials (seeded on first DB connect if no users exist)
ADMIN_EMAIL=admin@hostelpro.com
ADMIN_PASSWORD=change_this_secure_password_123

# Razorpay Keys for Online Payments (Optional: required only for live payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
